{
  "appId": "com.valiugt.app",
  "appName": "Valiu",
  "webDir": "www",
  "backgroundColor": "#eef5ec",
  "android": { "allowMixedContent": false, "captureInput": true },
  "ios": { "contentInset": "never", "scrollEnabled": true, "limitsNavigationsToAppBoundDomains": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 900, "launchAutoHide": true, "backgroundColor": "#eef5ec", "showSpinner": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
